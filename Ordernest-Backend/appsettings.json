{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=OrdernestDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "Ordernest",
    "Audience": "OrdernestClient",
    "Key": "CHANGE_ME_dev_only_super_long_signing_key_at_least_32_chars",
    "ExpiryMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Seed": {
    "AdminEmail": "admin@ordernest.local",
    "AdminPassword": "Admin#12345",
    "CashierEmail": "cashier@ordernest.local",
    "CashierPassword": "Cashier#12345"
  }
}
